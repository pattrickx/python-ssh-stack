# ===== HuggingFace =====
# Os modelos FLUX.1-dev e FLUX.1-Kontext-dev sao GATED.
# 1) Aceite a licenca em https://huggingface.co/black-forest-labs/FLUX.1-dev
# 2) Gere um token em https://huggingface.co/settings/tokens (permissao read)
# 3) Cole o token abaixo (substitua o placeholder)
HF_TOKEN=SEU_TOKEN_HUGGINGFACE_AQUI

# ===== Modelos (repo IDs no HuggingFace) =====
FLUX_DEV_REPO=black-forest-labs/FLUX.1-dev
FLUX_KONTEXT_REPO=black-forest-labs/FLUX.1-Kontext-dev

# ===== Diretorios =====
MODELS_DIR=/root/test-flux/models
OUTPUT_DIR=/root/test-flux/output

# ===== Inferencia =====
DEVICE=cuda
# FLUX.1-dev em fp16 nao cabe em 12GB; usar transformer em fp8 (TransformerFP8) ou quant
# Opcoes: "fp16" | "fp8" (recomendado p/ RTX 3060 12GB) | "bf16"
FLUX_PRECISION=fp8
NUM_INFERENCE_STEPS=28
GUIDANCE_SCALE=3.5
SEED=42

# ===== Cache local dos pesos (roda 100% local, sem API HF) =====
HF_HOME=/root/test-flux/models
HF_HUB_CACHE=/root/test-flux/models/hub
